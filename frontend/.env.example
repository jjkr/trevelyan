# AWS Bedrock Configuration
# Copy this file to .env and fill in your AWS credentials

# AWS Region (us-east-1 is recommended for Bedrock)
VITE_AWS_REGION=us-east-1

# AWS Credentials
# Option 1: Use AWS Access Keys
VITE_AWS_ACCESS_KEY_ID=your_access_key_here
VITE_AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Option 2: Use AWS CLI profile (alternative to access keys)
# If you have AWS CLI configured, you can leave the above empty
# and the SDK will automatically use your default profile

# Note: Make sure your AWS account has access to Bedrock
# and the Claude 3.5 Sonnet model is enabled in your region
